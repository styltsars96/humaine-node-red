{
  "name": "node-red-contrib-humaine",
  "version": "1.0.0",
  "description": "Node-RED nodes for HumAIne",
  "keywords": [
    "typescript",
    "node-red",
    "HumAIne",
    "Human-AI collaboration",
    ""
  ],
  "scripts": {
    "copy": "copyfiles -u 1 \"./nodes/**/*.{png,svg}\" \"./dist/nodes/\"",
    "build:editor": "rollup -c rollup.config.editor.js --bundleConfigAsCjs",
    "build:editor:watch": "rollup -c rollup.config.editor.js --bundleConfigAsCjs -w",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "build:runtime:watch": "tsc -p tsconfig.runtime.watch.json --watch --preserveWatchOutput",
    "build": "rm -rf dist && yarn copy && yarn build:editor && yarn build:runtime",
    "test": "jest --forceExit --detectOpenHandles --colors",
    "test:watch": "jest --forceExit --detectOpenHandles --watchAll",
    "dev": "rm -rf dist && yarn copy && concurrently --kill-others --names 'COPY,EDITOR,RUNTIME,TEST' --prefix '({name})' --prefix-colors 'yellow.bold,cyan.bold,greenBright.bold,magenta.bold' 'onchange -v \"src/**/*.png\" \"src/**/*.svg\" -- yarn copy' 'yarn build:editor:watch' 'yarn build:runtime:watch' 'sleep 10; yarn test:watch'",
    "lint": "prettier --ignore-path .eslintignore --check '**/*.{js,ts,md}'; eslint --ext .js,.ts .",
    "lint:fix": "prettier --ignore-path .eslintignore --write '**/*.{js,ts,md}'; eslint --ext .js,.ts . --fix"
  },
  "author": "stsarsitalidis@hua.gr",
  "license": "GPL-3.0+",
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "haic-config": "./dist/nodes/haic-config/haic-config.js",
      "ai-environment-config": "./dist/nodes/ai-environment-config/ai-environment-config.js"
    },
    "icons": "icons"
  },
  "dependencies": {
    "axios": "^0.21.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.1.0",
    "@types/node-red": "^1.3.5",
    "@types/node-red-node-test-helper": "^0.3.5",
    "@types/sinon": "^21.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "colorette": "^2.0.20",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.0",
    "jest": "^30.2.0",
    "mustache": "^4.2.0",
    "node-red": "^4.1.4",
    "node-red-node-test-helper": "^0.3.6",
    "onchange": "^7.1.0",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "ts-jest": "^29.4.6",
    "ts-to-zod": "^5.1.0",
    "typescript": "^5.9.3",
    "yarn": "^1.22.22"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
